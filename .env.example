# Copy this file to `.env` and fill in the values below to enable Google
# Drive sync (Configuración > Google Drive).
#
# Setup (one-time, done in Google Cloud Console, not in code):
#   1. Create/select a project, configure the OAuth consent screen (External).
#      While the app is in "Testing" status, refresh tokens expire every 7
#      days — add the store's Google account as a test user, or publish the
#      app for real use.
#   2. Enable the Google Drive API (APIs & Services > Library).
#   3. Credentials > Create Credentials > OAuth client ID > Application type
#      "TVs and Limited Input devices". This yields the Client ID + Secret
#      used below.

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
